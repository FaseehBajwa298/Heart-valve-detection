import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# =========================
# 1. Load Data
# =========================
waveforms = np.load("/kaggle/input/datasets/ameerabbas1/echonext/ECHONEXT/EchoNext_train_waveforms_2.npy")
metadata = pd.read_csv("/kaggle/input/datasets/ameerabbas1/echonext/ECHONEXT/echonext_metadata_100k.csv")

print("Waveform shape:", waveforms.shape)
print("Metadata shape:", metadata.shape)


# =========================
# 2. Select ECG (choose ONE)
# =========================

# 👉 Option A: By index
idx = 4

# 👉 Option B: By disease (uncomment if needed)
# filtered = metadata[metadata['aortic_stenosis_moderate_or_greater_flag'] == 1]
# idx = filtered.index[0]

# 👉 Option C: By patient key (uncomment if needed)
# filtered = metadata[metadata['patient_key'] == 12345]
# idx = filtered.index[0]


# =========================
# 3. Extract ECG
# =========================
ecg = waveforms[idx]      # shape: (1, 2500, 12)
ecg = ecg[0]              # shape: (2500, 12)

info = metadata.iloc[idx]

print("\nSelected Patient Info:")
print(info)


# =========================
# 4. Plot ECG (12 leads)
# =========================
