import numpy as np
import pandas as pd

# =========================
# 1. Load Data
# =========================
waveforms = np.load("/kaggle/input/datasets/ameerabbas1/echonext/ECHONEXT/EchoNext_train_waveforms_2.npy")
metadata = pd.read_csv("/kaggle/input/datasets/ameerabbas1/echonext/ECHONEXT/echonext_metadata_100k.csv")

# =========================
# 2. Match TRAIN split
# =========================
train_metadata = metadata[metadata['split'] == 'train'].reset_index(drop=True)

# =========================
# 3. YOUR INDEX
# =========================
idx = 4  # apni marzi ka index

# =========================
# 4. Extract ECG + Info
# =========================
ecg = waveforms[idx][0]
info = train_metadata.iloc[idx]

print("\nPatient Info:\n", info)

# =========================
# 5. 12 LABELS (FINAL)
# =========================
labels = {
    "LVEF ≤ 45%": info['lvef_lte_45_flag'],
    "LV Wall Thickness ≥ 13 mm": info['lvwt_gte_13_flag'],
    "Aortic Stenosis": info['aortic_stenosis_moderate_or_greater_flag'],
    "Aortic Regurgitation": info['aortic_regurgitation_moderate_or_greater_flag'],
    "Mitral Regurgitation": info['mitral_regurgitation_moderate_or_greater_flag'],
    "Tricuspid Regurgitation": info['tricuspid_regurgitation_moderate_or_greater_flag'],
    "Pulmonary Regurgitation": info['pulmonary_regurgitation_moderate_or_greater_flag'],
    "RV Systolic Dysfunction": info['rv_systolic_dysfunction_moderate_or_greater_flag'],
    "Pericardial Effusion": info['pericardial_effusion_moderate_large_flag'],
    "PASP ≥ 45 mmHg": info['pasp_gte_45_flag'],
    "TR Max Velocity ≥ 3.2": info['tr_max_gte_32_flag'],
    "Any SHD": info['shd_moderate_or_greater_flag']
}

# =========================
# 6. Show Diseases
# =========================
detected = [k for k, v in labels.items() if v == 1]

if len(detected) == 0:
    print("\nNo disease detected")
else:
    print("\nDetected Conditions:")
    for d in detected:
        print("-", d)

# =========================
# 7. SAVE ECG (Download)
# =========================
filename = f"ecg_patient_{info['patient_key']}.csv"
pd.DataFrame(ecg).to_csv(filename, index=False)

print(f"\nECG saved as: {filename}")


np.save("ecg_index_4.npy", ecg)



np.save(f"ecg_patient_{info['patient_key']}.npy", ecg)




